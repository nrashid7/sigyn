# ── Vercel (apps/web) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=                   # legacy JWT (sb_secret_* keys do not pass verify_jwt)
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SETUP=                          # one-time price
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# ── Supabase edge-function secrets (put in supabase/.env.local, then `npm run secrets:set`) ──
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=                   # printed by `npm run setup:elevenlabs`
ELEVENLABS_TOOL_SECRET=                      # printed by `npm run setup:elevenlabs`
ELEVENLABS_TOOL_IDS=                         # JSON printed by `npm run setup:elevenlabs`
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                         # fallback SMS sender
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
N8N_WEBHOOK_BASE_URL=https://n8n-production-08c9.up.railway.app/webhook
N8N_WEBHOOK_SECRET=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Local scripts only ────────────────────────────────────────
N8N_API_URL=https://n8n-production-08c9.up.railway.app
N8N_API_KEY=
SUPABASE_URL=                                # for scripts/elevenlabs-setup.mjs and scripts/smoke-elevenlabs.mjs
