{
  "name": "BusinessVoice - SMS Follow-Up",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sms-follow-up",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "sms-follow-up"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.metadata?.beta_readiness_check === true }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-readiness",
      "name": "Is Readiness Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.type }}",
              "operation": "equal",
              "value2": "missed_call"
            }
          ]
        }
      },
      "id": "switch-type",
      "name": "Message Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.body.phone }}",
        "message": "Hi! We noticed we missed your call. Reply to this message or call us back — we'd love to help!"
      },
      "id": "twilio-missed",
      "name": "Twilio Missed Call",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [910, 200],
      "credentials": { "twilioApi": { "id": "1", "name": "Twilio" } }
    },
    {
      "parameters": {
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.body.phone }}",
        "message": "Your appointment is confirmed! We look forward to seeing you. Reply CANCEL to reschedule."
      },
      "id": "twilio-confirm",
      "name": "Twilio Confirmation",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [910, 400],
      "credentials": { "twilioApi": { "id": "1", "name": "Twilio" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1130, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Is Readiness Check", "type": "main", "index": 0 }]] },
    "Is Readiness Check": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }],
        [{ "node": "Message Type", "type": "main", "index": 0 }]
      ]
    },
    "Message Type": {
      "main": [
        [{ "node": "Twilio Missed Call", "type": "main", "index": 0 }],
        [{ "node": "Twilio Confirmation", "type": "main", "index": 0 }]
      ]
    },
    "Twilio Missed Call": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Twilio Confirmation": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "BusinessVoice" }]
}
