{
  "name": "businessvoice-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:push": "supabase db push --linked",
    "deploy:functions": "supabase functions deploy --use-api",
    "secrets:set": "supabase secrets set --env-file supabase/.env.local",
    "test": "npm run test:node && npm run test:deno",
    "test:node": "node --test \"scripts/**/*.test.mjs\"",
    "test:deno": "deno test --allow-env --allow-read supabase/functions/tests",
    "deploy:n8n": "node scripts/deploy-n8n-workflows.mjs",
    "setup:elevenlabs": "node scripts/elevenlabs-setup.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
